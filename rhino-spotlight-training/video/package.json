{
  "name": "rhino-spotlight-training-video",
  "version": "0.1.0",
  "private": true,
  "description": "Remotion project for Rhino Spotlight Training videos",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "studio": "remotion studio",
    "compositions": "remotion compositions",
    "render:test": "remotion render RenderTest out/render-test.mp4 --is-production=false",
    "still:test": "remotion still RenderTest out/render-test-preview.png --frame=90 --is-production=false",
    "render:test:cloud": "remotion render RenderTest out/render-test.mp4 --is-production=false --browser-executable=$REMOTION_BROWSER",
    "still:test:cloud": "remotion still RenderTest out/render-test-preview.png --frame=90 --is-production=false --browser-executable=$REMOTION_BROWSER",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.544",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.544"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "typescript": "5.9.3"
  }
}
